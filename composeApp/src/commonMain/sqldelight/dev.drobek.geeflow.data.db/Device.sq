import kotlin.Boolean;

CREATE TABLE devices (
  macAddress TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  isLastUsed INTEGER AS Boolean NOT NULL DEFAULT 0,
  manufacturer TEXT NOT NULL DEFAULT '',
  model TEXT NOT NULL DEFAULT '',
  version TEXT NOT NULL DEFAULT '',
  boundProfileId INTEGER DEFAULT NULL
);

selectAll:
SELECT * FROM devices;

selectByMacAddress:
SELECT * FROM devices WHERE macAddress = ?;

insertDevice:
INSERT OR IGNORE INTO devices(macAddress, name, isLastUsed, manufacturer, model, version)
VALUES (?, ?, ?, ?, ?, ?);

updateDeviceInfo:
UPDATE devices SET name = ?, isLastUsed = ?, manufacturer = ?, model = ?, version = ? WHERE macAddress = ?;

resetLastUsed:
UPDATE devices SET isLastUsed = 0;

setLastUsed:
UPDATE devices SET isLastUsed = 1 WHERE macAddress = ?;

bindProfile:
UPDATE devices SET boundProfileId = ? WHERE macAddress = ?;

unbindProfile:
UPDATE devices SET boundProfileId = NULL WHERE macAddress = ?;

deleteByMacAddress:
DELETE FROM devices WHERE macAddress = ?;

clearAll:
DELETE FROM devices;
