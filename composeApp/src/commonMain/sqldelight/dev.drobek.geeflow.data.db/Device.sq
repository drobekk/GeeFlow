import kotlin.Boolean;

CREATE TABLE devices (
  macAddress TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  isLastUsed INTEGER AS Boolean NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM devices;

selectByMacAddress:
SELECT * FROM devices WHERE macAddress = ?;

insertDevice:
INSERT OR REPLACE INTO devices(macAddress, name, isLastUsed) VALUES (?, ?, ?);

resetLastUsed:
UPDATE devices SET isLastUsed = 0;

setLastUsed:
UPDATE devices SET isLastUsed = 1 WHERE macAddress = ?;

deleteByMacAddress:
DELETE FROM devices WHERE macAddress = ?;

clearAll:
DELETE FROM devices;
