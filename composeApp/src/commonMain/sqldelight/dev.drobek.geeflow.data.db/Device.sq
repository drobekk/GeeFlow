import kotlin.Boolean;

CREATE TABLE devices (
  serialNumber TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  isLastUsed INTEGER AS Boolean NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM devices;

selectBySerialNumber:
SELECT * FROM devices WHERE serialNumber = ?;

insertDevice:
INSERT OR REPLACE INTO devices(serialNumber, name, isLastUsed) VALUES (?, ?, ?);

updateLastUsed:
UPDATE devices SET isLastUsed = 0;
UPDATE devices SET isLastUsed = 1 WHERE serialNumber = ?;

deleteBySerialNumber:
DELETE FROM devices WHERE serialNumber = ?;

clearAll:
DELETE FROM devices;
