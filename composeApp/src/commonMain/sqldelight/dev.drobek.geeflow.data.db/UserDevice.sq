CREATE TABLE user_devices (
  userId INTEGER NOT NULL,
  deviceMacAddress TEXT NOT NULL,
  PRIMARY KEY(userId, deviceMacAddress),
  FOREIGN KEY(userId) REFERENCES users(id) ON DELETE CASCADE,
  FOREIGN KEY(deviceMacAddress) REFERENCES devices(macAddress) ON DELETE CASCADE
);

selectDevicesForUser:
SELECT d.* FROM devices d
JOIN user_devices ud ON d.macAddress = ud.deviceMacAddress
WHERE ud.userId = ?;

insertUserDevice:
INSERT OR IGNORE INTO user_devices(userId, deviceMacAddress) VALUES (?, ?);

deleteUserDevice:
DELETE FROM user_devices WHERE userId = ? AND deviceMacAddress = ?;
