{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hostinghk.pangxinlabi.top/profile-library/catalog.schema.json",
  "title": "GeeFlow profile library v1/v2",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "profiles"
  ],
  "additionalProperties": false,
  "$defs": {
    "targetSource": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Constant",
            "MeasurementAtEntry",
            "CapturedValue",
            "PreviousGoal",
            "PreviousApplied"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "metric": {
          "anyOf": [
            {
              "enum": [
                "PumpPressure",
                "GroupPressure",
                "BoilerPressure",
                "PumpFlow",
                "PumpedVolume",
                "CupWeight"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "capture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "enum": [
            "PumpPressure",
            "GroupPressure",
            "BoilerPressure",
            "PumpFlow",
            "PumpedVolume",
            "CupWeight"
          ]
        },
        "windowMillis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "maximumAgeMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "filter": {
          "enum": [
            "Latest",
            "Mean"
          ]
        },
        "minimum": {
          "type": "number",
          "minimum": 0
        },
        "maximum": {
          "type": "number",
          "minimum": 0
        },
        "fallback": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "metric"
      ],
      "additionalProperties": false
    },
    "limit": {
      "type": "object",
      "properties": {
        "metric": {
          "enum": [
            "PumpPressure",
            "PumpFlow"
          ]
        },
        "ceiling": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "hysteresis": {
          "type": "number",
          "minimum": 0
        },
        "reductionPerSecond": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "recoveryPerSecond": {
          "type": "number",
          "minimum": 0
        },
        "overshootAllowance": {
          "type": "number",
          "minimum": 0
        },
        "tripDurationMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "metric",
        "ceiling"
      ],
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "properties": {
        "metric": {
          "enum": [
            "PumpPressure",
            "GroupPressure",
            "BoilerPressure",
            "PumpFlow",
            "PumpedVolume",
            "CupWeight",
            "PhaseTime"
          ]
        },
        "comparison": {
          "enum": [
            "Above",
            "Below",
            "StrictlyAbove",
            "StrictlyBelow"
          ]
        },
        "threshold": {
          "type": "number",
          "minimum": 0
        },
        "scope": {
          "enum": [
            "Total",
            "Step"
          ]
        }
      },
      "required": [
        "metric",
        "comparison",
        "threshold"
      ],
      "additionalProperties": false
    },
    "control": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "pressure"
            },
            "bar": {
              "type": "number",
              "minimum": 0
            },
            "location": {
              "enum": [
                "Pump",
                "Group",
                "Boiler"
              ]
            }
          },
          "required": [
            "type",
            "bar"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "flow"
            },
            "millilitresPerSecond": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "millilitresPerSecond"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "pump_pause"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ramp": {
      "type": "object",
      "properties": {
        "style": {
          "enum": [
            "Instant",
            "Linear",
            "EaseIn",
            "EaseOut",
            "EaseInOut"
          ]
        },
        "durationMillis": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "enum": [
            "PreviousTarget",
            "CurrentMeasurement"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/targetSource"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "phase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "control": {
          "$ref": "#/$defs/control"
        },
        "maximumDurationMillis": {
          "type": "integer",
          "minimum": 1
        },
        "minimumDurationMillis": {
          "type": "integer",
          "minimum": 0
        },
        "ramp": {
          "$ref": "#/$defs/ramp"
        },
        "exitConditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "conditionOperator": {
          "enum": [
            "Or",
            "And"
          ]
        },
        "adaptiveFlowProbe": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "samplingDurationMillis": {
                  "type": "integer",
                  "minimum": 1
                },
                "pressureCeilingBar": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "flowBackoffMillilitresPerSecond": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "samplingDurationMillis",
                "pressureCeilingBar"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "targetSource": {
          "anyOf": [
            {
              "$ref": "#/$defs/targetSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "entryCaptures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capture"
          }
        },
        "exitCaptures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capture"
          }
        },
        "secondaryLimit": {
          "anyOf": [
            {
              "$ref": "#/$defs/limit"
            },
            {
              "type": "null"
            }
          ]
        },
        "temperatureC": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 130
            },
            {
              "type": "null"
            }
          ]
        },
        "stabilityDurationMillis": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "control",
        "maximumDurationMillis"
      ],
      "additionalProperties": false
    },
    "recording": {
      "type": "object",
      "properties": {
        "controlMode": {
          "enum": [
            "Pressure",
            "Flow"
          ]
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "elapsedMillis": {
                "type": "integer",
                "minimum": 0
              },
              "data": {
                "type": "object",
                "properties": {
                  "pressure": {
                    "type": "number",
                    "minimum": 0
                  },
                  "weight": {
                    "type": "number",
                    "minimum": 0
                  },
                  "volume": {
                    "type": "number",
                    "minimum": 0
                  },
                  "flowRate": {
                    "type": "number",
                    "minimum": 0
                  },
                  "weightRate": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "pressure",
                  "weight",
                  "volume",
                  "flowRate",
                  "weightRate"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "elapsedMillis",
              "data"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "controlMode",
        "samples"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "original": {
          "type": "object"
        }
      },
      "required": [
        "format",
        "title",
        "sha256",
        "original"
      ],
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "properties": {
        "templateId": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "templatePhases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phase"
          }
        },
        "settings": {
          "type": "object",
          "properties": {
            "doseG": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "ratio": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "targetYieldG": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adaptation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unresolvedSemantics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "templateId",
        "source",
        "templatePhases"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "maximumTotalDurationMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "program": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "enum": [
                1,
                2
              ]
            },
            "execution": {
              "$ref": "#/$defs/execution"
            },
            "type": {
              "const": "phases"
            },
            "phases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/phase"
              }
            },
            "recipe": {
              "anyOf": [
                {
                  "$ref": "#/$defs/recipe"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "phases"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "enum": [
                1,
                2
              ]
            },
            "execution": {
              "$ref": "#/$defs/execution"
            },
            "type": {
              "const": "recording"
            },
            "recording": {
              "$ref": "#/$defs/recording"
            },
            "originalRecording": {
              "anyOf": [
                {
                  "$ref": "#/$defs/recording"
                },
                {
                  "type": "null"
                }
              ]
            },
            "replayPolicy": {
              "enum": [
                "Legacy",
                "Hold",
                "Linear"
              ]
            }
          },
          "required": [
            "type",
            "recording"
          ],
          "additionalProperties": false
        }
      ]
    },
    "profile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "finishCondition": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "weight",
                    "volume"
                  ]
                },
                "target": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "type",
                "target"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "autoLinkOpen": {
          "type": "boolean"
        },
        "singleDoseSettings": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "grindingSize": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600
            },
            "grindingSpeed": {
              "type": "integer",
              "minimum": 200,
              "maximum": 1000
            }
          },
          "required": [
            "enabled",
            "grindingSize",
            "grindingSpeed"
          ],
          "additionalProperties": false
        },
        "program": {
          "$ref": "#/$defs/program"
        }
      },
      "required": [
        "name",
        "description",
        "autoLinkOpen",
        "singleDoseSettings",
        "program"
      ],
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "favorite": {
          "type": "boolean"
        },
        "deleted": {
          "type": "boolean"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        }
      },
      "required": [
        "id",
        "revision",
        "favorite",
        "deleted",
        "profile"
      ],
      "additionalProperties": false
    }
  }
}
