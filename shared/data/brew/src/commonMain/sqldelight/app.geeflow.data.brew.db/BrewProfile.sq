import app.geeflow.data.brew.model.Condition;
import app.geeflow.data.brew.model.ProfileMode;
import app.geeflow.data.brew.model.ProfileStep;
import kotlin.collections.List;

CREATE TABLE brew_profiles (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  userId INTEGER NOT NULL,
  name TEXT NOT NULL,
  description TEXT NOT NULL,
  mode TEXT AS ProfileMode NOT NULL DEFAULT 'VariablePressure',
  finishCondition TEXT AS Condition NOT NULL,
  autoLinkOpen INTEGER NOT NULL DEFAULT 0,
  steps TEXT AS List<ProfileStep> NOT NULL,
  position INTEGER NOT NULL DEFAULT 0,
  FOREIGN KEY(userId) REFERENCES users(id) ON DELETE CASCADE
);

selectAll:
SELECT * FROM brew_profiles ORDER BY position ASC;

selectByUserId:
SELECT * FROM brew_profiles WHERE userId = ? ORDER BY position ASC;

selectById:
SELECT * FROM brew_profiles WHERE id = ?;

insertBrewProfile:
INSERT OR REPLACE INTO brew_profiles(id, userId, name, description, mode, finishCondition, autoLinkOpen, steps, position) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM brew_profiles WHERE id = ?;
