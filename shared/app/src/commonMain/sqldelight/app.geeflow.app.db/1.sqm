ALTER TABLE brew_profiles ADD COLUMN singleDoseEnabled INTEGER NOT NULL DEFAULT 0;
ALTER TABLE brew_profiles ADD COLUMN singleDoseGrindingSize INTEGER NOT NULL DEFAULT 300;
ALTER TABLE brew_profiles ADD COLUMN singleDoseGrindingSpeed INTEGER NOT NULL DEFAULT 500;

ALTER TABLE devices ADD COLUMN modelId TEXT;
ALTER TABLE devices ADD COLUMN modelSource TEXT;

UPDATE devices
SET modelId = 'wendougee.data-s', modelSource = 'migration'
WHERE lower(manufacturer) = 'wendougee';
