CREATE TABLE users (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  photoUri TEXT,
  isSelected INTEGER NOT NULL DEFAULT 0,
  favoriteDeviceId INTEGER
);

selectAll:
SELECT * FROM users;

selectById:
SELECT * FROM users WHERE id = ?;

insertUser:
INSERT OR REPLACE INTO users(id, name, photoUri, isSelected, favoriteDeviceId) VALUES (?, ?, ?, ?, ?);

deleteById:
DELETE FROM users WHERE id = ?;

resetSelected:
UPDATE users SET isSelected = 0;

setSelected:
UPDATE users SET isSelected = 1 WHERE id = ?;

setFavoriteDevice:
UPDATE users SET favoriteDeviceId = ? WHERE id = ?;
